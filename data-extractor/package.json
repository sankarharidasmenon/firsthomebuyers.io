{
  "name": "data-extractor",
  "version": "1.0.0",
  "private": true,
  "description": "Deterministic web scraper for Australian Government First Home Buyer grants & schemes (Federal, NSW, VIC). Outputs a structured Excel workbook. No AI/inference — official sources only.",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "scrape": "ts-node src/index.ts",
    "scrape:dry": "ts-node src/index.ts --dry-run",
    "start": "node dist/index.js",
    "clean": "rimraf dist output/government_schemes.xlsx output/sources.json logs/scrape.log"
  },
  "keywords": [
    "australia",
    "first-home-buyer",
    "government-grants",
    "scraper",
    "deterministic",
    "excel"
  ],
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.7",
    "cheerio": "^1.0.0",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "p-limit": "^3.1.0",
    "pdf-parse": "^1.1.1",
    "playwright": "^1.48.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pdf-parse": "^1.1.4",
    "rimraf": "^5.0.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
