# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
# JUnit output from the integration suite (uploaded as a CI artifact instead)
/test-results

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the committed template, which holds names + placeholders only,
# never real values. Keep this negation below the .env* rule.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.agents

/docs/

/data-extractor/

/scripts/


/scratch-act-audit.ts
/scratch-impact.ts
/scratch-multi.ts
/scratch-others.ts
/tmp-trace.ts
/tmp-verify-live.ts
